#!name=G1 ACQ TEST
#!desc=逐档验证 AI Pro 卡片可指向的真实商品 ID；本模块自带原版报告页，先停用 G1 ACQ 再启用
#!system=ios

[Rule]
# 压掉 UDP 443，让 one.google.com 走 TCP，否则 http-response 看不到正文
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq-test = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/xiaohei210509/g1-acq-test@v3/g1-acq-test.js
g1-switch = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-test\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/xiaohei210509/g1-acq-test@v3/g1-switch.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
