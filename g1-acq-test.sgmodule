#!name=G1 ACQ TEST
#!desc=页面会列出响应里出现的全部编号，点“试”即可当目标；自带原版报告页
#!system=ios

[Rule]
# 压掉 UDP 443，让 one.google.com 走 TCP，否则 http-response 看不到正文
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq-test = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/xiaohei210509/g1-acq-test@v5/g1-acq-test.js
g1-switch = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-test\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/xiaohei210509/g1-acq-test@v5/g1-switch.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
