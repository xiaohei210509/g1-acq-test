#!name=G1 ACQ TEST FIXED
#!desc=固定候选版：改 script-path 里的 cand/N.js 换档；本模块自带原版报告页
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq-test = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/xiaohei210509/g1-acq-test@v2/cand/2.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.5.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
